# Data (kept local only)
data/
**/*.parquet
**/*.zip

# Models / checkpoints
**/*.pth
**/*.pt
**/*.ckpt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/

# Office owner/lock files (~$Figure_Explainer.docx) — Word writes one beside every open
# document and removes it on close, so they are session state, never deliverables.
~$*

# Transient run artifacts (crash-safety partials + raw sweep logs, incl. the ~27MB run.err)
**/*_partial.csv
notebooks/*.err
notebooks/*.log

# Local scratch backups of result tables (not deliverables)
scratch_backup/
